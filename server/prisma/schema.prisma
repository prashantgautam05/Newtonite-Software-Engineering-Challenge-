generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Models ──────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  teamMemberships    TeamMembership[]
  assignedItems      WorkItem[]       @relation("AssignedItems")
  reportedItems      WorkItem[]       @relation("ReportedItems")
  comments           Comment[]
  historyEntries     WorkItemHistory[]
  approvalsRequested Approval[]        @relation("ApprovalRequester")
  approvalsResolved  Approval[]        @relation("ApprovalResolver")

  @@map("users")
}

model Team {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  members   TeamMembership[]
  workItems WorkItem[]

  @@map("teams")
}

model TeamMembership {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  teamId   String   @map("team_id")
  role     String   @default("MEMBER") // ADMIN, MEMBER, VIEWER
  joinedAt DateTime @default(now()) @map("joined_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
  @@map("team_memberships")
}

model WorkItem {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("OPEN") // OPEN, IN_PROGRESS, AWAITING_APPROVAL, RESOLVED, CLOSED
  priority    String    @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW
  category    String    @default("OTHER") // CUSTOMER_ISSUE, INCIDENT, COMPLIANCE, PAYMENT, OPERATIONAL, OTHER
  version     Int       @default(1)
  dueDate     DateTime? @map("due_date")
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Foreign keys
  assigneeId String? @map("assignee_id")
  reporterId String  @map("reporter_id")
  teamId     String  @map("team_id")

  // Relations
  assignee  User?             @relation("AssignedItems", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter  User              @relation("ReportedItems", fields: [reporterId], references: [id])
  team      Team              @relation(fields: [teamId], references: [id])
  comments  Comment[]
  history   WorkItemHistory[]
  approvals Approval[]

  // Indexes for search and filtering
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([teamId])
  @@index([category])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("work_items")
}

model WorkItemHistory {
  id           String   @id @default(uuid())
  workItemId   String   @map("work_item_id")
  userId       String   @map("user_id")
  action       String   // e.g. "CREATED", "STATUS_CHANGED", "ASSIGNED", "PRIORITY_CHANGED"
  fieldChanged String?  @map("field_changed")
  oldValue     String?  @map("old_value")
  newValue     String?  @map("new_value")
  timestamp    DateTime @default(now())

  // Relations
  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([workItemId])
  @@index([timestamp])
  @@map("work_item_history")
}

model Comment {
  id         String   @id @default(uuid())
  content    String
  workItemId String   @map("work_item_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([workItemId])
  @@index([createdAt])
  @@map("comments")
}

model Approval {
  id            String    @id @default(uuid())
  workItemId    String    @map("work_item_id")
  requestedById String    @map("requested_by_id")
  resolvedById  String?   @map("resolved_by_id")
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reason        String?
  createdAt     DateTime  @default(now()) @map("created_at")
  resolvedAt    DateTime? @map("resolved_at")

  // Relations
  workItem    WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  requestedBy User     @relation("ApprovalRequester", fields: [requestedById], references: [id])
  resolvedBy  User?    @relation("ApprovalResolver", fields: [resolvedById], references: [id])

  @@index([workItemId])
  @@index([status])
  @@map("approvals")
}
